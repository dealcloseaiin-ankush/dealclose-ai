<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DealClose SIM Gateway"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Turn this mobile into your 24/7 AI Voice Calling &amp; Payment Recovery Gateway"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚪ STATUS: NOT PAIRED"
            android:textColor="#F59E0B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#1F1F2E"
            android:padding="12dp"
            android:layout_marginTop="20dp" />

        <!-- Step 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1: Set Default Phone App"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Required to access cellular in-call audio for AI voice conversation"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/btnSetDefaultDialer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set as Default Phone App"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginTop="8dp" />

        <!-- Step 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 2: Disable Battery Saver"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Keeps SIM gateway active 24/7 when phone is locked on table"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <Button
            android:id="@+id/btnBatteryOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ignore Battery Optimizations"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#374151"
            android:layout_marginTop="8dp" />

        <!-- Step 3 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 3: Pair Device"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter 6-digit code shown on your DealClose AI Calling Hub"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <EditText
            android:id="@+id/etPairingCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 748291"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B7280"
            android:inputType="number"
            android:gravity="center"
            android:letterSpacing="0.2"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="#1F1F2E"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnPairDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activate SIM Gateway 🚀"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#10B981"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
