<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E"
    android:keepScreenOn="true"
    android:padding="24dp">

    <!-- Top Bar: SIM Badge & Mode Indicator -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- SIM Badge -->
        <TextView
            android:id="@+id/tvSimBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="📶 SIM 1 • Active"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- AI Mode Status Pill -->
        <TextView
            android:id="@+id/tvAiModePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#064E3B"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="🤖 DealClose AI Voice Agent"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Caller Information Section (Center) -->
    <LinearLayout
        android:id="@+id/callerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Glowing Center Avatar Icon -->
        <TextView
            android:id="@+id/tvAvatarIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="#0F172A"
            android:gravity="center"
            android:text="📞"
            android:textSize="44sp" />

        <!-- Caller Name / Number -->
        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Incoming Call..."
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="+91 00000 00000"
            android:textColor="#94A3B8"
            android:textSize="17sp" />

        <!-- Call Status / Timer -->
        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ringing..."
            android:textColor="#A7F3D0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Live Subtitle / Note -->
        <TextView
            android:id="@+id/tvAiNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="DealClose AI Neha is ready to answer..."
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Action Controls for Ringing State (Answer / Decline) -->
    <LinearLayout
        android:id="@+id/layoutRingingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Decline Button -->
        <Button
            android:id="@+id/btnDeclineCall"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:backgroundTint="#EF4444"
            android:text="🔴 Decline"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Answer Button -->
        <Button
            android:id="@+id/btnAnswerCall"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="#10B981"
            android:text="🟢 Answer"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Action Controls for Active / Connected State -->
    <LinearLayout
        android:id="@+id/layoutActiveControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="36dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Secondary Controls: Take Over / Speaker / Mute -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTakeOver"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:backgroundTint="#3B82F6"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="🎙️ Khud Baat Karein (Take Over)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnSpeaker"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="🔊 Speaker Off"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnEndCall"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#DC2626"
                android:text="📵 End Call"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
