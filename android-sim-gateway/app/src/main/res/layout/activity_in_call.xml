<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E"
    android:keepScreenOn="true"
    android:paddingStart="24dp"
    android:paddingTop="36dp"
    android:paddingEnd="24dp"
    android:paddingBottom="40dp">

    <!-- Top Status Bar: SIM & Call Mode Indicators -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- SIM Badge -->
        <TextView
            android:id="@+id/tvSimBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:text="📶 SIM 1 • Active"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- AI Mode Status Pill -->
        <TextView
            android:id="@+id/tvAiModePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_badge"
            android:paddingStart="14dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp"
            android:text="🤖 DealClose AI Voice Agent"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Caller Information Section (Centered) -->
    <LinearLayout
        android:id="@+id/callerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Circular Contact Avatar with Glowing Ring (Stock Android Style) -->
        <TextView
            android:id="@+id/tvAvatarIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="👤"
            android:textSize="40sp" />

        <!-- Caller Name -->
        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Incoming Call..."
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Caller Phone Number -->
        <TextView
            android:id="@+id/tvCallerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="+91 00000 00000"
            android:textColor="#94A3B8"
            android:textSize="17sp" />

        <!-- Call Status / Timer -->
        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ringing..."
            android:textColor="#A7F3D0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Live Subtitle / Note -->
        <TextView
            android:id="@+id/tvAiNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="DealClose AI Neha is ready to answer..."
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Action Controls: Ringing State (Circular Stock Android Buttons) -->
    <LinearLayout
        android:id="@+id/layoutRingingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Decline Action Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDeclineCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/btn_circle_decline"
                android:elevation="6dp"
                android:gravity="center"
                android:text="📵"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Decline"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Answer Action Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAnswerCall"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/btn_circle_answer"
                android:elevation="6dp"
                android:gravity="center"
                android:text="📞"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Answer"
                android:textColor="#22C55E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Controls: Active / Connected State -->
    <LinearLayout
        android:id="@+id/layoutActiveControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Take Over Pill (AI Call Mode) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTakeOver"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_takeover_pill"
                android:elevation="4dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="🎙️ Khud Baat Karein (Take Over)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Circular Active Call Buttons (Speaker & End Call) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Speaker Toggle Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/btn_circle_action"
                    android:elevation="4dp"
                    android:gravity="center"
                    android:text="🔊"
                    android:textColor="#E2E8F0"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvSpeakerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Speaker ON"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- End Call Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnEndCall"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/btn_circle_decline"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:text="📵"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="End Call"
                    android:textColor="#EF4444"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
